{
  "manifest_version": 3,
  "name": "YouTube Sign Language Assistant",
  "version": "1.0",
  "description": "Provides sign language translation for YouTube videos",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webview"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "http://localhost:5000/*",
    "http://vhg.cmp.uea.ac.uk/*"

  ],    
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src 'self' http://localhost:5000"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [{
    "resources": [
        "work/avatarnew.html",
        "avatarnew.html",
        "avatar_files/*",
        "SignFiles/*",
        "js/*",
        "jquery.min.js",
        "avatars/*"
      ],
    "matches": ["https://www.youtube.com/*"]
  }]
}